# Copie para .env.local e preencha.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave publishable (sb_publishable_...) ou a anon key antiga
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só para o script de seed. Nunca use no app nem faça commit.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (R2 → Manage API tokens → token com Object Read & Write no bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kineti-exercise-videos
# Opcional: domínio público do bucket (ex.: https://videos.kineti.com.br).
# Sem ele, o app gera URLs assinadas de 1 hora para assistir aos vídeos.
R2_PUBLIC_URL=
